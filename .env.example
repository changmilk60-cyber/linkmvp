# Postgres connection string. Railway/Vercel Postgres/Neon all provide this automatically.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Any long random string — used to sign login session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# Public URL of your deployed app (used to build short-link URLs shown in the dashboard)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
