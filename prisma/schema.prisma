generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  links        Link[]
}

enum LinkType {
  SHORT
  BIO
}

model Link {
  id         String   @id @default(cuid())
  slug       String   @unique
  type       LinkType

  // SHORT link fields
  targetUrl  String?

  // BIO page fields
  title      String?
  bio        String?
  themeColor String?
  avatarEmoji String?
  blocks     String?  // JSON string: [{ "label": "...", "url": "..." }]
  fbPixelId  String?  // Facebook Pixel ID for tracking visits/conversions on this bio page
  template   String?  @default("classic") // "classic" | "service" | "course" | "custom"
  customCode String?  // raw HTML/CSS/JS the owner wants embedded on their bio page
  images     String?  // JSON string: ["/uploads/xxx.jpg", ...] uploaded gallery images
  fontFamily String?  // Google Font name applied to the course template
  sectionToggles String? // JSON string: {"carousel":true,"quiz":true,"countdown":true,"reviews":true,"faq":true,"promotions":true,"pricing":true,"contact":true}
  reviews    String?  // JSON string: [{ "name": "...", "text": "..." }]
  faq        String?  // JSON string: [{ "q": "...", "a": "..." }]
  promotions String?  // JSON string: [{ "label": "...", "detail": "..." }]
  pricing    String?  // JSON string: [{ "name": "...", "price": "...", "features": "...", "highlight": true }]
  contact    String?  // JSON string: { "phone": "...", "line": "...", "email": "...", "address": "..." }

  clicks     Int      @default(0)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  @@index([userId])
}
