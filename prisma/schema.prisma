generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  pages        Page[]
}

// One PageVIP Pro sales page + its "หลังบ้านแก้เว็บ" admin settings, per user.
model Page {
  id     String @id @default(cuid())
  slug   String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ---- license ----
  licenseExpiresAt DateTime @default(dbgenerated("(now() + interval '365 days')"))

  // ---- appearance ----
  themePreset     String  @default("green-black")
  tabTitle        String?
  ogDescription   String?
  ogImage         String?
  logoUrl         String?
  lineLogoUrl     String?
  footerText      String?
  footerTextColor String?
  colorOverrides  String? // JSON: {primary?, textPrimary?, textBody?, textMuted?, ctaText?, lineCtaText?}

  // ---- pixel / CAPI ----
  fbPixelIds      String? // JSON string[] of pixel ids
  capiAccessToken String?
  capiEndpointUrl String?
  capiEventName   String  @default("subscribe") // "subscribe" | "purchase"
  ctaLayout       String  @default("horizontal") // "vertical" | "horizontal"

  // ---- bot / whitepage cloak ----
  landingUrl           String?
  whitepageRedirectUrl String?
  useSameLandingForAll Boolean @default(true)
  cloakToLandingUrl    Boolean @default(false)

  // ---- hero text ----
  heroHeadline String?
  heroSubtext  String?

  // ---- sections (order + enabled + per-section data) ----
  sections String @default("[]") // JSON array, see lib/sections.ts

  // ---- random reviews ----
  reviewsTitle    String?
  reviewsSubtitle String?
  reviews         String? // JSON: [{ member, text, stars }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]

  @@index([userId])
}

// One row per real page view / button click, bucketed by UTC day, for the
// Dashboard panel's stat tiles + 7-day chart + daily table.
model Visit {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  day       String // "YYYY-MM-DD" UTC bucket
  kind      String // "view" | "click_signup" | "click_line"
  visitorId String // random id from the sc_vid cookie — approximate unique count, not PII
  createdAt DateTime @default(now())

  @@index([pageId, day])
}
